{
  "rules": {
    "online": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.child('n').isString() && newData.child('n').val().length <= 20 && newData.child('x').isNumber() && newData.child('z').isNumber())"
      }
    },
    "chat": {
      ".read": true,
      ".indexOn": ["t"],
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.child('uid').val() === auth.uid && newData.child('m').isString() && newData.child('m').val().length <= 120 && newData.child('n').isString() && newData.child('n').val().length <= 30 && newData.child('t').val() === now"
      }
    },
    "papan": {
      ".read": true,
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.child('uid').val() === auth.uid && newData.child('m').isString() && newData.child('m').val().length <= 80 && newData.child('t').val() === now"
      }
    },
    "karyawan": {
      ".read": true,
      ".indexOn": ["t"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('uid').val() === auth.uid && newData.child('n').isString() && newData.child('n').val().length <= 20 && newData.child('t').isNumber()"
      }
    }
  }
}
